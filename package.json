{
  "name": "ooting-crm",
  "version": "1.0.0",
  "private": true,
  "description": "Ooting CRM & Travel Business Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --workspace=server run dev",
    "dev:client": "npm --workspace=client run dev",
    "build": "npm --workspace=server run prisma:generate && npm --workspace=client run build && npm --workspace=server run build",
    "start": "npm --workspace=server run start",
    "postinstall": "npm --workspace=server run prisma:generate",
    "prisma:generate": "npm --workspace=server run prisma:generate",
    "prisma:push": "npm --workspace=server run prisma:push",
    "db:migrate:mysql": "npm --workspace=server run db:migrate:mysql",
    "db:setup:local": "npm --workspace=server run db:setup:local",
    "db:dump": "npm --workspace=server run db:dump",
    "prisma:pg:generate": "npm --workspace=server run prisma:pg:generate",
    "prisma:pg:push": "npm --workspace=server run prisma:pg:push",
    "setup:prod:admin": "npm --workspace=server run setup:prod:admin",
    "prisma:seed": "npm --workspace=server run prisma:seed",
    "prisma:studio": "npm --workspace=server run prisma:studio"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  }
}
