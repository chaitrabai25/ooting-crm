# ==============================================================================
# Ooting CRM — Production Environment Configuration Template
# NOTE: DO NOT COMMIT REAL SECRETS OR PASSWORDS TO GITHUB.
# In production (e.g. Render / Railway / Supabase), configure these securely in the dashboard.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# Database URL
# For Production Cloud MySQL (TiDB Cloud / Aiven):
DATABASE_URL="mysql://username:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ooting_crm?sslaccept=strict"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET="generate_a_strong_64_character_random_secret_here"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Hostinger SMTP Configuration (Secure Email OTP Login & Password Reset)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@ooting.in
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM_EMAIL=noreply@ooting.in
SMTP_FROM_NAME=noreply-ooting

# Initial Super Admin (Created only if database is brand new and empty)
ADMIN_EMAIL="admin@ooting.com"
ADMIN_PASSWORD="ChooseYourSecurePassword123!"

# Company Details Defaults
COMPANY_NAME="Ooting"
COMPANY_TAGLINE="Journeys Beyond Ordinary"
COMPANY_EMAIL="contact@ooting.com"
COMPANY_PHONE="+91 98765 43210"
COMPANY_ADDRESS="Ooting Holidays Private Limited, Bangalore, Karnataka, India"
COMPANY_GSTIN="29AABCO1234F1Z5"

# Optional: Only needed if frontend is hosted on a separate domain
# VITE_API_URL="https://your-crm-backend.onrender.com"
