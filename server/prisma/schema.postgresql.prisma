// Prisma Schema for OOTING CRM - PostgreSQL Version for Cloud & Production (Neon / Supabase / AWS RDS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES
  OPERATIONS
  ACCOUNTANT
  AGENT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  FOLLOW_UP
  WON
  LOST
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum BookingStatus {
  ENQUIRY
  HOLD
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(SALES)
  phone        String?
  status             String    @default("ACTIVE")
  permissions        String?
  lastLoginAt        DateTime?
  otpHash            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  lastOtpRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedCustomers      Customer[]       @relation("CustomerAssignedUser")
  assignedLeads          Lead[]           @relation("LeadAssignedUser")
  assignedFollowUps      FollowUp[]       @relation("FollowUpAssignedUser")
  assignedBookings       Booking[]        @relation("BookingAssignedUser")
  quotationsCreated      Quotation[]      @relation("QuotationCreatedByUser")
  assignedCabBookings    CabBooking[]     @relation("CabBookingAssignedUser")
  assignedCalendarEvents CalendarEvent[]  @relation("CalendarEventAssignedUser")
  expensesCreated        Expense[]        @relation("ExpenseCreatedByUser")
  assignedSuppliers      Supplier[]       @relation("SupplierAssignedUser")
  auditLogs              AuditLog[]       @relation("UserAuditLogs")

  @@index([email])
  @@index([role])
}

model Customer {
  id             String    @id @default(uuid())
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  city           String?
  state          String?
  country        String?   @default("India")
  source         String?   @default("DIRECT")
  notes          String?
  assignedToId   String?
  status         String    @default("ACTIVE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo     User?       @relation("CustomerAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  leads          Lead[]
  bookings       Booking[]
  quotations     Quotation[]
  cabBookings    CabBooking[]

  @@index([phone])
  @@index([email])
}

model Lead {
  id              String         @id @default(uuid())
  customerId      String
  assignedUserId  String?
  source          String         @default("WEBSITE")
  destination     String
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int            @default(2)
  children        Int            @default(0)
  infants         Int            @default(0)
  budget          Decimal?       @db.Decimal(12, 2)
  packageId       String?
  enquiryStatus   LeadStatus     @default(NEW)
  priority        Priority       @default(MEDIUM)
  notes           String?
  nextFollowUpAt  DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer        Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser    User?          @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  package         Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  quotations      Quotation[]
  bookings        Booking[]
  cabBookings     CabBooking[]

  @@index([customerId])
  @@index([enquiryStatus])
  @@index([destination])
}

model FollowUp {
  id             String         @id @default(uuid())
  leadId         String
  assignedUserId String?
  scheduledAt    DateTime
  type           FollowUpType   @default(CALL)
  notes          String?
  status         FollowUpStatus @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser   User?          @relation("FollowUpAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([scheduledAt])
}

model Package {
  id          String         @id @default(uuid())
  packageName String
  destination String
  duration    String
  description String
  price       Decimal        @default(0) @db.Decimal(12, 2)
  packageType String         @default("HOLIDAY")
  inclusions  String?
  exclusions  String?
  imageUrl    String?
  gallery     String? // JSON string array of image URLs
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  itineraries ItineraryDay[]
  leads       Lead[]
  bookings    Booking[]
  quotations  Quotation[]
  cabBookings CabBooking[]

  @@index([destination])
}

model ItineraryDay {
  id          String   @id @default(uuid())
  packageId   String
  dayNumber   Int
  title       String
  description String
  activities  String?
  places      String?
  startTime   String?
  endTime     String?
  imageUrl    String? // Primary photo for this day
  images      String? // JSON array of day-wise photo URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

model Quotation {
  id                 String    @id @default(uuid())
  quotationNumber    String    @unique
  leadId             String?
  customerId         String
  packageId          String?
  destination        String
  travelStartDate    DateTime?
  travelEndDate      DateTime?
  adults             Int       @default(2)
  children           Int       @default(0)
  infants            Int       @default(0)
  accommodation      String?
  transport          String?
  activities         String?
  inclusions         String?
  exclusions         String?
  cabDetails         String?
  additionalCharges  Decimal   @default(0) @db.Decimal(12, 2)
  paymentTerms       String?
  cancellationTerms  String?
  notes              String?
  basePrice          Decimal   @default(0) @db.Decimal(12, 2)
  discount           Decimal   @default(0) @db.Decimal(12, 2)
  tax                Decimal   @default(0) @db.Decimal(12, 2)
  finalAmount        Decimal   @default(0) @db.Decimal(12, 2)
  status             String    @default("DRAFT")
  termsAndConditions String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package            Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdByUser      User?     @relation("QuotationCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([quotationNumber])
  @@index([createdById])
}

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique
  customerId      String
  leadId          String?
  packageId       String?
  assignedUserId  String?
  travelStartDate DateTime
  travelEndDate   DateTime
  travellers      Int           @default(1)
  totalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  discount        Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount     Decimal       @default(0) @db.Decimal(12, 2)
  bookingStatus   BookingStatus @default(CONFIRMED)
  bookingDate     DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  package         Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedUser    User?         @relation("BookingAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  payments        Payment[]
  expenses        Expense[]
  agentBooking    AgentBooking?
  travellersList  Traveller[]
  cabBookings     CabBooking[]

  @@index([bookingNumber])
}

model Traveller {
  id        String   @id @default(uuid())
  bookingId String
  name      String
  age       Int?
  gender    String? // MALE, FEMALE, OTHER
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id                   String        @id @default(uuid())
  bookingId            String
  customerId           String?
  amount               Decimal       @default(0) @db.Decimal(12, 2)
  paymentDate          DateTime      @default(now())
  paymentTime          String?
  paymentMethod        PaymentMethod @default(UPI)
  transactionReference String?       @unique
  screenshotUrl        String?
  recordedById         String?
  paymentStatus        PaymentStatus @default(SUCCESS)
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([customerId])
  @@index([transactionReference])
}

model Agent {
  id                 String         @id @default(uuid())
  companyName        String
  contactPerson      String
  phone              String
  email              String?
  city               String?
  state              String?
  gstNumber          String?
  status             String         @default("ACTIVE")
  googleReviewUrl    String?
  googleReviewRating Decimal?       @db.Decimal(3, 2)
  googleReviewNotes  String?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  agentBookings AgentBooking[]

  @@index([companyName])
}

model AgentBooking {
  id               String   @id @default(uuid())
  agentId          String
  bookingId        String   @unique
  commissionRate   Decimal  @default(0) @db.Decimal(5, 2)
  commissionAmount Decimal  @default(0) @db.Decimal(12, 2)
  netAmount        Decimal  @default(0) @db.Decimal(12, 2)
  payoutStatus     String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Decimal  @default(0) @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  description String
  bookingId   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("ExpenseCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
}

model CompanySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model WhatsAppMessage {
  id             String    @id @default(uuid())
  customerId     String?
  phone          String
  messageContent String
  templateName   String?
  status         String    @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  provider       String?   // META_CLOUD_API, TWILIO, DIRECT_WEB
  externalId     String?
  errorDetails   String?
  sentByUserId   String?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([phone])
  @@index([createdAt])
}

model CabBooking {
  id                  String    @id @default(uuid())
  bookingReference    String    @unique // e.g. "OOT-CAB-202609-001"
  customerId          String?
  customerName        String
  customerPhone       String
  customerEmail       String?
  leadId              String?
  bookingId           String?
  packageId           String?
  assignedStaffId     String?
  pickupDate          DateTime
  pickupTime          String
  pickupPlace         String
  dropPlace           String
  travelRoute         String?
  enquiryDate         DateTime? @default(now())
  carNumber           String?
  vehicleType         String    @default("SEDAN") // SEDAN, SUV, INNOVA, TEMPO_TRAVELLER, HATCHBACK, LUXURY
  passengerCount      Int       @default(1)
  driverName          String?
  driverPhone         String?
  cabProvider         String?
  requiredCabType     String?   @default("AC") // AC, NON_AC
  tripType            String    @default("OUTSTATION") // ONE_WAY, ROUND_TRIP, LOCAL, OUTSTATION
  estimatedDistance   String?
  estimatedDuration   String?
  cabAmount           Decimal   @default(0) @db.Decimal(12, 2)
  advanceAmount       Decimal   @default(0) @db.Decimal(12, 2)
  balanceAmount       Decimal   @default(0) @db.Decimal(12, 2)
  paymentStatus       String    @default("PENDING") // PENDING, PARTIAL, PAID, REFUNDED
  bookingStatus       String    @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED, ON_TRIP
  specialInstructions String?
  internalNotes       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking             Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  package             Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedStaff       User?     @relation("CabBookingAssignedUser", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([bookingReference])
  @@index([customerPhone])
  @@index([pickupDate])
  @@index([bookingStatus])
  @@index([assignedStaffId])
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  eventType   String    @default("TASK") // MEETING, TASK, REMINDER, FOLLOW_UP, CAB_TRIP, DEPARTURE, PAYMENT_DUE, LEAVE
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  userId      String?
  customerId  String?
  leadId      String?
  bookingId   String?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation("CalendarEventAssignedUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate])
  @@index([eventType])
  @@index([status])
}

model Supplier {
  id                  String    @id @default(uuid())
  name                String
  supplierType        String    @default("HOTEL")
  contactPerson       String?
  phone               String
  whatsapp            String?
  email               String?
  alternateContact    String?
  website             String?
  address             String?
  city                String?
  state               String?
  country             String?   @default("India")
  gstNumber           String?
  category            String?
  servicesProvided    String?
  destinationsCovered String?
  contractDetails     String?
  paymentTerms        String?
  creditLimit         Decimal?  @default(0) @db.Decimal(12, 2)
  commissionDetails   String?
  bankDetails         String?
  status              String    @default("ACTIVE")
  assignedToId        String?
  tags                String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedUser        User?     @relation("SupplierAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([supplierType])
  @@index([phone])
  @@index([city])
  @@index([status])
  @@index([assignedToId])
}

