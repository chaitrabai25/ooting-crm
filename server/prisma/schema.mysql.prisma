// ==============================================================================
// Ooting CRM - Production MySQL Database Schema
// Database Engine: MySQL 8.0+ (InnoDB)
// Supports: Local MySQL (Development) and Cloud MySQL (Vercel Production)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. User & Authentication
// ------------------------------------------------------------------------------
// ------------------------------------------------------------------------------
// 0. Multi-Tenant Companies & White-Label Brands
// ------------------------------------------------------------------------------
model Company {
  id                String    @id @default(uuid()) @db.VarChar(36)
  name              String    @db.VarChar(191)
  slug              String    @unique @db.VarChar(100)
  status            String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, SUSPENDED, INACTIVE
  logoUrl           String?   @db.LongText
  faviconUrl        String?   @db.LongText
  tagline           String?   @db.VarChar(255)
  primaryColor      String?   @default("#1E3A8A") @db.VarChar(50)
  secondaryColor    String?   @default("#E11D48") @db.VarChar(50)
  phone             String?   @db.VarChar(50)
  email             String?   @db.VarChar(191)
  website           String?   @db.VarChar(191)
  address           String?   @db.Text
  city              String?   @db.VarChar(100)
  state             String?   @db.VarChar(100)
  country           String?   @default("India") @db.VarChar(100)
  pincode           String?   @db.VarChar(20)
  gstin             String?   @db.VarChar(50)
  bankName          String?   @db.VarChar(191)
  accountHolderName String?   @db.VarChar(191)
  accountNumber     String?   @db.VarChar(100)
  accountType       String?   @default("CURRENT") @db.VarChar(50)
  ifsc              String?   @db.VarChar(50)
  branch            String?   @db.VarChar(100)
  upiId             String?   @db.VarChar(100)
  paymentNotes      String?   @db.Text
  isOoting          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users             User[]
  customers         Customer[]
  leads             Lead[]
  followUps         FollowUp[]
  packages          Package[]
  quotations        Quotation[]
  bookings          Booking[]
  payments          Payment[]
  cabBookings       CabBooking[]
  agents            Agent[]
  suppliers         Supplier[]
  expenses          Expense[]
  calendarEvents    CalendarEvent[]
  whatsAppMessages  WhatsAppMessage[]
  auditLogs         AuditLog[]
  places            Place[]
  hotels            Hotel[]
  companySettings   CompanySetting[]

  @@index([status])
  @@index([slug])
  @@index([isOoting])
}

model User {
  companyId          String?   @db.VarChar(36)
  id                 String    @id @default(uuid()) @db.VarChar(36)
  name               String    @db.VarChar(191)
  email              String    @unique @db.VarChar(191)
  passwordHash       String    @db.VarChar(255)
  role               String    @default("SALES") @db.VarChar(50) // SUPER_ADMIN, ADMIN, SALES, OPERATIONS, ACCOUNTANT, AGENT
  phone              String?   @db.VarChar(50)
  status             String    @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE, SUSPENDED
  permissions        String?   @db.Text
  lastLoginAt        DateTime?
  otpHash            String?   @db.VarChar(255)
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  lastOtpRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedCustomers      Customer[]       @relation("CustomerAssignedUser")
  customersCreated       Customer[]       @relation("CustomerCreatedByUser")
  customersUpdated       Customer[]       @relation("CustomerUpdatedByUser")

  assignedLeads          Lead[]           @relation("LeadAssignedUser")
  leadsCreated           Lead[]           @relation("LeadCreatedByUser")
  leadsUpdated           Lead[]           @relation("LeadUpdatedByUser")

  assignedFollowUps      FollowUp[]       @relation("FollowUpAssignedUser")

  assignedBookings       Booking[]        @relation("BookingAssignedUser")
  bookingsCreated        Booking[]        @relation("BookingCreatedByUser")
  bookingsUpdated        Booking[]        @relation("BookingUpdatedByUser")

  quotationsCreated      Quotation[]      @relation("QuotationCreatedByUser")
  quotationsUpdated      Quotation[]      @relation("QuotationUpdatedByUser")

  assignedCabBookings    CabBooking[]     @relation("CabBookingAssignedUser")
  assignedCalendarEvents CalendarEvent[]  @relation("CalendarEventAssignedUser")
  expensesCreated        Expense[]        @relation("ExpenseCreatedByUser")
  assignedSuppliers      Supplier[]       @relation("SupplierAssignedUser")
  auditLogs              AuditLog[]       @relation("UserAuditLogs")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 2. Customer Directory
// ------------------------------------------------------------------------------
model Customer {
  companyId          String?   @db.VarChar(36)
  id             String    @id @default(uuid()) @db.VarChar(36)
  fullName       String    @db.VarChar(191)
  phone          String    @db.VarChar(50)
  alternatePhone String?   @db.VarChar(50)
  email          String?   @db.VarChar(191)
  city           String?   @db.VarChar(100)
  state          String?   @db.VarChar(100)
  country        String?   @default("India") @db.VarChar(100)
  source         String?   @default("DIRECT") @db.VarChar(50)
  notes          String?   @db.Text
  assignedToId   String?   @db.VarChar(36)
  status         String    @default("ACTIVE") @db.VarChar(50)

  createdById    String?   @db.VarChar(36)
  updatedById    String?   @db.VarChar(36)
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedById    String?   @db.VarChar(36)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo     User?        @relation("CustomerAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUser  User?        @relation("CustomerCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser  User?        @relation("CustomerUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)

  leads          Lead[]
  bookings       Booking[]
  quotations     Quotation[]
  cabBookings    CabBooking[]

  @@index([phone])
  @@index([email])
  @@index([fullName])
  @@index([assignedToId])
  @@index([isDeleted])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 3. Leads & Enquiries
// ------------------------------------------------------------------------------
model Lead {
  companyId          String?   @db.VarChar(36)
  id              String    @id @default(uuid()) @db.VarChar(36)
  customerId      String    @db.VarChar(36)
  assignedUserId  String?   @db.VarChar(36)
  source          String    @default("WEBSITE") @db.VarChar(50)
  destination     String    @db.VarChar(191)
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(2)
  children        Int       @default(0)
  infants         Int       @default(0)
  budget          Float?
  packageId       String?   @db.VarChar(36)
  enquiryStatus   String    @default("NEW") @db.VarChar(50)
  priority        String    @default("MEDIUM") @db.VarChar(50)
  notes           String?   @db.Text
  nextFollowUpAt  DateTime?

  createdById     String?   @db.VarChar(36)
  updatedById     String?   @db.VarChar(36)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedById     String?   @db.VarChar(36)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser    User?        @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser   User?        @relation("LeadCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser   User?        @relation("LeadUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)
  package         Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  quotations      Quotation[]
  bookings        Booking[]
  cabBookings     CabBooking[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([enquiryStatus])
  @@index([destination])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([isDeleted])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 4. Follow-ups & Reminders
// ------------------------------------------------------------------------------
model FollowUp {
  companyId          String?   @db.VarChar(36)
  id             String    @id @default(uuid()) @db.VarChar(36)
  leadId         String    @db.VarChar(36)
  assignedUserId String?   @db.VarChar(36)
  scheduledAt    DateTime
  type           String    @default("CALL") @db.VarChar(50)
  notes          String?   @db.Text
  status         String    @default("PENDING") @db.VarChar(50)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser   User?     @relation("FollowUpAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assignedUserId])
  @@index([scheduledAt])
  @@index([status])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 5. Tour Packages & Catalog
// ------------------------------------------------------------------------------
model Package {
  companyId          String?   @db.VarChar(36)
  id          String   @id @default(uuid()) @db.VarChar(36)
  packageName String   @db.VarChar(191)
  destination String   @db.VarChar(191)
  duration    String   @db.VarChar(100)
  description String   @db.Text
  price       Float    @default(0)
  packageType String   @default("HOLIDAY") @db.VarChar(50)
  inclusions  String?  @db.Text
  exclusions  String?  @db.Text
  imageUrl    String?  @db.LongText
  gallery     String?  @db.LongText
  status      String   @default("ACTIVE") @db.VarChar(50)

  // B2B Travel Agent Branding Snapshot (Per-Itinerary)
  b2bAgentId         String?   @db.VarChar(36)
  b2bAgencyName      String?   @db.VarChar(191)
  b2bAgencyLogo      String?   @db.LongText
  b2bContactPerson   String?   @db.VarChar(191)
  b2bPhone           String?   @db.VarChar(50)
  b2bAlternatePhone  String?   @db.VarChar(50)
  b2bEmail           String?   @db.VarChar(191)
  b2bAddress         String?   @db.Text
  b2bCity            String?   @db.VarChar(100)
  b2bState           String?   @db.VarChar(100)
  b2bGstin           String?   @db.VarChar(50)
  b2bWebsite         String?   @db.VarChar(191)
  b2bTagline         String?   @db.VarChar(255)
  customBranding     String?   @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itineraries ItineraryDay[]
  leads       Lead[]
  bookings    Booking[]
  quotations  Quotation[]
  cabBookings CabBooking[]

  @@index([destination])
  @@index([packageType])
  @@index([status])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 6. Day-Wise Itineraries
// ------------------------------------------------------------------------------
model ItineraryDay {
  id          String   @id @default(uuid()) @db.VarChar(36)
  packageId   String   @db.VarChar(36)
  dayNumber   Int
  title       String   @db.VarChar(191)
  description String   @db.Text
  activities  String?  @db.Text
  places      String?  @db.Text
  startTime   String?  @db.VarChar(50)
  endTime     String?  @db.VarChar(50)
  date        String?  @db.VarChar(50)
  highlights  String?  @db.Text
  travelDetails String? @db.Text
  hotelId     String?  @db.VarChar(36)
  hotelName   String?  @db.VarChar(191)
  hotelStarCategory String? @db.VarChar(50)
  hotelImageUrl String? @db.LongText
  hotelLocation String? @db.VarChar(191)
  hotelDetails String? @db.Text
  mealPlan    String?  @db.VarChar(100)
  hotelCheckIn String? @db.VarChar(50)
  hotelCheckOut String? @db.VarChar(50)
  imageUrl    String?  @db.LongText
  images      String?  @db.LongText
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([dayNumber])
}

// ------------------------------------------------------------------------------
// 7. Quotations & Proposals
// ------------------------------------------------------------------------------
model Quotation {
  companyId          String?   @db.VarChar(36)
  id                 String    @id @default(uuid()) @db.VarChar(36)
  quotationNumber    String    @unique @db.VarChar(100)
  leadId             String?   @db.VarChar(36)
  customerId         String    @db.VarChar(36)
  packageId          String?   @db.VarChar(36)
  destination        String    @db.VarChar(191)
  travelStartDate    DateTime?
  travelEndDate      DateTime?
  adults             Int       @default(2)
  children           Int       @default(0)
  infants            Int       @default(0)
  accommodation      String?   @db.Text
  transport          String?   @db.Text
  activities         String?   @db.Text
  inclusions         String?   @db.Text
  exclusions         String?   @db.Text
  cabDetails         String?   @db.Text
  additionalCharges  Float     @default(0)
  paymentTerms       String?   @db.Text
  cancellationTerms  String?   @db.Text
  notes              String?   @db.Text
  basePrice          Float     @default(0)
  basePackagePrice   Float     @default(0)
  adultUnitPrice     Float     @default(0)
  childUnitPrice     Float     @default(0)
  infantUnitPrice    Float     @default(0)
  discount           Float     @default(0)
  tax                Float     @default(0)
  finalAmount        Float     @default(0)
  status             String    @default("DRAFT") @db.VarChar(50)
  termsAndConditions String?   @db.Text

  createdById        String?   @db.VarChar(36)
  updatedById        String?   @db.VarChar(36)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  deletedById        String?   @db.VarChar(36)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package            Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdByUser      User?     @relation("QuotationCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser      User?     @relation("QuotationUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([quotationNumber])
  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@index([isDeleted])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 8. Bookings
// ------------------------------------------------------------------------------
model Booking {
  companyId          String?   @db.VarChar(36)
  id               String    @id @default(uuid()) @db.VarChar(36)
  bookingNumber    String    @unique @db.VarChar(100)
  customerId       String    @db.VarChar(36)
  leadId           String?   @db.VarChar(36)
  packageId        String?   @db.VarChar(36)
  assignedUserId   String?   @db.VarChar(36)
  travelStartDate  DateTime
  travelEndDate    DateTime
  durationDays     Int?      @default(1)
  durationNights   Int?      @default(0)
  tripType         String?   @default("SINGLE") @db.VarChar(50)
  travellers       Int       @default(1)
  totalAmount      Float     @default(0)
  discount         Float     @default(0)
  finalAmount      Float     @default(0)
  bookingStatus    String    @default("CONFIRMED") @db.VarChar(50)
  bookingDate      DateTime  @default(now())
  serviceProviders String?   @db.Text
  notes            String?   @db.Text

  createdById      String?   @db.VarChar(36)
  updatedById      String?   @db.VarChar(36)
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedById      String?   @db.VarChar(36)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  package          Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedUser     User?         @relation("BookingAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser    User?         @relation("BookingCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser    User?         @relation("BookingUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)

  payments         Payment[]
  expenses         Expense[]
  agentBooking     AgentBooking?
  travellersList   Traveller[]
  cabBookings      CabBooking[]

  @@index([bookingNumber])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([bookingStatus])
  @@index([bookingDate])
  @@index([isDeleted])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 9. Passengers & Travellers
// ------------------------------------------------------------------------------
model Traveller {
  id        String   @id @default(uuid()) @db.VarChar(36)
  bookingId String   @db.VarChar(36)
  name      String   @db.VarChar(191)
  age       Int?
  gender    String?  @db.VarChar(50)
  phone     String?  @db.VarChar(50)
  email     String?  @db.VarChar(191)
  idNumber  String?  @db.VarChar(100)
  address   String?  @db.Text
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ------------------------------------------------------------------------------
// 10. Payments & Receipts
// ------------------------------------------------------------------------------
model Payment {
  companyId          String?   @db.VarChar(36)
  id                   String   @id @default(uuid()) @db.VarChar(36)
  bookingId            String   @db.VarChar(36)
  customerId           String?  @db.VarChar(36)
  amount               Float    @default(0)
  paymentDate          DateTime @default(now())
  paymentTime          String?  @db.VarChar(50)
  paymentMethod        String   @default("UPI") @db.VarChar(50)
  transactionReference String?  @unique @db.VarChar(191)
  screenshotUrl        String?  @db.VarChar(500)
  recordedById         String?  @db.VarChar(36)
  paymentStatus        String   @default("SUCCESS") @db.VarChar(50)
  notes                String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([transactionReference])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 11. B2B Travel Agents & Partners
// ------------------------------------------------------------------------------
model Agent {
  companyId          String?   @db.VarChar(36)
  id                 String   @id @default(uuid()) @db.VarChar(36)
  companyName        String   @db.VarChar(191)
  contactPerson      String   @db.VarChar(191)
  phone              String   @db.VarChar(50)
  email              String?  @db.VarChar(191)
  city               String?  @db.VarChar(100)
  state              String?  @db.VarChar(100)
  gstNumber          String?  @db.VarChar(50)
  panNumber          String?  @db.VarChar(50)
  agentType          String?  @default("Silver") @db.VarChar(50)
  status             String   @default("ACTIVE") @db.VarChar(50)
  googleReviewUrl    String?  @db.Text
  googleReviewRating Float?
  googleReviewNotes  String?  @db.Text
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agentBookings AgentBooking[]

  @@index([companyName])
  @@index([phone])
  @@index([email])
  @@index([status])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model AgentBooking {
  id               String   @id @default(uuid()) @db.VarChar(36)
  agentId          String   @db.VarChar(36)
  bookingId        String   @unique @db.VarChar(36)
  commissionRate   Float    @default(0)
  commissionAmount Float    @default(0)
  netAmount        Float    @default(0)
  payoutStatus     String   @default("PENDING") @db.VarChar(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([bookingId])
  @@index([payoutStatus])
}

// ------------------------------------------------------------------------------
// 12. Office & Tour Expenses
// ------------------------------------------------------------------------------
model Expense {
  companyId          String?   @db.VarChar(36)
  id          String   @id @default(uuid()) @db.VarChar(36)
  category    String   @db.VarChar(50)
  amount      Float    @default(0)
  expenseDate DateTime @default(now())
  description String   @db.Text
  bookingId   String?  @db.VarChar(36)
  createdById String?  @db.VarChar(36)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("ExpenseCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([bookingId])
  @@index([expenseDate])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 13. System Audit Logs
// ------------------------------------------------------------------------------
model AuditLog {
  companyId          String?   @db.VarChar(36)
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String?  @db.VarChar(36)
  userName    String?  @db.VarChar(191)
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entityId    String?  @db.VarChar(191)
  details     String?  @db.Text
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  ipAddress   String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  user        User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 14. Company Branding & Settings
// ------------------------------------------------------------------------------
model CompanySetting {
  companyId          String?   @db.VarChar(36)
  id          String   @id @default(uuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt

  @@index([key])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 15. WhatsApp Logs
// ------------------------------------------------------------------------------
model WhatsAppMessage {
  companyId          String?   @db.VarChar(36)
  id             String    @id @default(uuid()) @db.VarChar(36)
  customerId     String?   @db.VarChar(36)
  phone          String    @db.VarChar(50)
  messageContent String    @db.Text
  templateName   String?   @db.VarChar(100)
  status         String    @default("PENDING") @db.VarChar(50)
  provider       String?   @db.VarChar(50)
  externalId     String?   @db.VarChar(191)
  errorDetails   String?   @db.Text
  sentByUserId   String?   @db.VarChar(36)
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([phone])
  @@index([createdAt])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 16. Cab Bookings & Fleet Transfers
// ------------------------------------------------------------------------------
model CabBooking {
  companyId          String?   @db.VarChar(36)
  id                   String    @id @default(uuid()) @db.VarChar(36)
  bookingReference     String    @unique @db.VarChar(100)
  customerId           String?   @db.VarChar(36)
  customerName         String    @db.VarChar(191)
  customerPhone        String    @db.VarChar(50)
  customerEmail        String?   @db.VarChar(191)
  leadId               String?   @db.VarChar(36)
  bookingId            String?   @db.VarChar(36)
  packageId            String?   @db.VarChar(36)
  assignedStaffId      String?   @db.VarChar(36)
  pickupDate           DateTime
  pickupTime           String    @db.VarChar(50)
  pickupPlace          String    @db.VarChar(191)
  dropPlace            String    @db.VarChar(191)
  travelRoute          String?   @db.Text
  enquiryDate          DateTime? @default(now())
  carNumber            String?   @db.VarChar(50)
  vehicleType          String    @default("SEDAN") @db.VarChar(50)
  passengerCount       Int       @default(1)
  driverName           String?   @db.VarChar(191)
  driverPhone          String?   @db.VarChar(50)
  cabProvider          String?   @db.VarChar(100)
  requiredCabType      String?   @default("AC") @db.VarChar(50)
  tripType             String    @default("OUTSTATION") @db.VarChar(50)
  estimatedDistance    String?   @db.VarChar(50)
  estimatedDuration    String?   @db.VarChar(50)
  cabAmount            Float     @default(0)
  advanceAmount        Float     @default(0)
  balanceAmount        Float     @default(0)
  paymentStatus        String    @default("PENDING") @db.VarChar(50)
  bookingStatus        String    @default("CONFIRMED") @db.VarChar(50)
  specialInstructions  String?   @db.Text
  internalNotes        String?   @db.Text

  driverAllowanceType  String?   @db.VarChar(50)
  driverAllowanceRate  Float?
  driverAllowanceDays  Int?
  driverAllowanceTotal Float?
  dutyRange            String?   @db.VarChar(191)
  customTableRows      String?   @db.Text

  createdById          String?   @db.VarChar(36)
  updatedById          String?   @db.VarChar(36)
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  deletedById          String?   @db.VarChar(36)

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                 Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking              Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  package              Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedStaff        User?     @relation("CabBookingAssignedUser", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([bookingReference])
  @@index([customerPhone])
  @@index([pickupDate])
  @@index([bookingStatus])
  @@index([assignedStaffId])
  @@index([isDeleted])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 17. Calendar & Tasks
// ------------------------------------------------------------------------------
model CalendarEvent {
  companyId          String?   @db.VarChar(36)
  id          String    @id @default(uuid()) @db.VarChar(36)
  title       String    @db.VarChar(191)
  description String?   @db.Text
  eventType   String    @default("TASK") @db.VarChar(50)
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  userId      String?   @db.VarChar(36)
  customerId  String?   @db.VarChar(36)
  leadId      String?   @db.VarChar(36)
  bookingId   String?   @db.VarChar(36)
  status      String    @default("PENDING") @db.VarChar(50)
  priority    String    @default("MEDIUM") @db.VarChar(50)
  color       String?   @db.VarChar(50)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation("CalendarEventAssignedUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate])
  @@index([eventType])
  @@index([status])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ------------------------------------------------------------------------------
// 18. B2B Suppliers Directory
// ------------------------------------------------------------------------------
model Supplier {
  companyId          String?   @db.VarChar(36)
  id                  String    @id @default(uuid()) @db.VarChar(36)
  name                String    @db.VarChar(191)
  supplierType        String    @default("HOTEL") @db.VarChar(50)
  contactPerson       String?   @db.VarChar(191)
  phone               String    @db.VarChar(50)
  whatsapp            String?   @db.VarChar(50)
  email               String?   @db.VarChar(191)
  alternateContact    String?   @db.VarChar(50)
  website             String?   @db.VarChar(255)
  address             String?   @db.Text
  city                String?   @db.VarChar(100)
  district            String?   @db.VarChar(100)
  state               String?   @db.VarChar(100)
  country             String?   @default("India") @db.VarChar(100)
  pincode             String?   @db.VarChar(20)
  gstNumber           String?   @db.VarChar(50)
  panNumber           String?   @db.VarChar(50)
  tier                String?   @default("Silver") @db.VarChar(50)
  serviceCategories   String?   @db.Text
  categoryDetails     String?   @db.Text
  category            String?   @db.VarChar(100)
  servicesProvided    String?   @db.Text
  destinationsCovered String?   @db.Text
  contractDetails     String?   @db.Text
  paymentTerms        String?   @db.VarChar(191)
  creditLimit         Float?    @default(0)
  commissionDetails   String?   @db.Text
  bankDetails         String?   @db.Text
  status              String    @default("ACTIVE") @db.VarChar(50)
  assignedToId        String?   @db.VarChar(36)
  tags                String?   @db.VarChar(255)
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedUser        User?     @relation("SupplierAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([supplierType])
  @@index([phone])
  @@index([city])
  @@index([status])
  @@index([assignedToId])

  company            Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

