  state                      String?   @db.VarChar(100)
  country                    String?   @default("India") @db.VarChar(100)
  pincode                    String?   @db.VarChar(20)
  languages                  String?   @db.Text // JSON string array of languages e.g. ["Kannada","English","Hindi"]
  expertise                  String?   @db.Text // e.g. "Wildlife, Heritage, Trekking, Pilgrimage"
  destinations               String?   @db.Text // e.g. "Coorg, Ooty, Dandeli, Hampi, Mysore"
