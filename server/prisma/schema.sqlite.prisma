// Prisma Schema for OOTING CRM
// Relational schema with foreign keys, indexes, and full relationship integrity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         String    @default("SALES") // SUPER_ADMIN, ADMIN, SALES, OPERATIONS, ACCOUNTANT, AGENT
  phone        String?
  status             String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  permissions        String?   // JSON object with module-level permissions
  lastLoginAt        DateTime?
  otpHash            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  lastOtpRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedCustomers      Customer[]       @relation("CustomerAssignedUser")
  assignedLeads          Lead[]           @relation("LeadAssignedUser")
  assignedFollowUps      FollowUp[]       @relation("FollowUpAssignedUser")
  assignedBookings       Booking[]        @relation("BookingAssignedUser")
  quotationsCreated      Quotation[]      @relation("QuotationCreatedByUser")
  assignedCabBookings    CabBooking[]     @relation("CabBookingAssignedUser")
  assignedCalendarEvents CalendarEvent[]  @relation("CalendarEventAssignedUser")
  expensesCreated        Expense[]        @relation("ExpenseCreatedByUser")
  assignedSuppliers      Supplier[]       @relation("SupplierAssignedUser")
  auditLogs              AuditLog[]       @relation("UserAuditLogs")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

model Customer {
  id             String    @id @default(uuid())
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  city           String?
  state          String?
  country        String?   @default("India")
  source         String?   @default("DIRECT") // WEBSITE, WHATSAPP, REFERRAL, SOCIAL_MEDIA, B2B_AGENT, WALK_IN, OTHER
  notes          String?
  assignedToId   String?
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo     User?       @relation("CustomerAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  leads          Lead[]
  bookings       Booking[]
  quotations     Quotation[]
  cabBookings    CabBooking[]

  @@index([phone])
  @@index([email])
  @@index([fullName])
  @@index([assignedToId])
}

model Lead {
  id              String    @id @default(uuid())
  customerId      String
  assignedUserId  String?
  source          String    @default("WEBSITE") // WEBSITE, WHATSAPP, PHONE, INSTAGRAM, REFERRAL, B2B_AGENT, OTHER
  destination     String
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(2)
  children        Int       @default(0)
  infants         Int       @default(0)
  budget          Float?
  packageId       String?
  enquiryStatus   String    @default("NEW") // NEW, CONTACTED, QUALIFIED, QUOTATION_SENT, FOLLOW_UP, WON, LOST, CANCELLED
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes           String?
  nextFollowUpAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser    User?       @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  package         Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  quotations      Quotation[]
  bookings        Booking[]
  cabBookings     CabBooking[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([enquiryStatus])
  @@index([destination])
  @@index([createdAt])
  @@index([nextFollowUpAt])
}

model FollowUp {
  id             String    @id @default(uuid())
  leadId         String
  assignedUserId String?
  scheduledAt    DateTime
  type           String    @default("CALL") // CALL, WHATSAPP, EMAIL, MEETING, OTHER
  notes          String?
  status         String    @default("PENDING") // PENDING, COMPLETED, CANCELLED, RESCHEDULED
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser   User?     @relation("FollowUpAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assignedUserId])
  @@index([scheduledAt])
  @@index([status])
}

model Package {
  id          String   @id @default(uuid())
  packageName String
  destination String
  duration    String // e.g. "3 Days / 2 Nights"
  description String
  price       Float    @default(0)
  packageType String   @default("HOLIDAY") // HOLIDAY, FLIGHT, HOTEL, BUS, CUSTOM
  inclusions  String? // JSON or text list of inclusions
  exclusions  String? // JSON or text list of exclusions
  imageUrl    String?
  gallery     String? // JSON string array of image URLs
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itineraries ItineraryDay[]
  leads       Lead[]
  bookings    Booking[]
  quotations  Quotation[]
  cabBookings CabBooking[]

  @@index([destination])
  @@index([packageType])
  @@index([status])
}

model ItineraryDay {
  id          String   @id @default(uuid())
  packageId   String
  dayNumber   Int
  title       String
  description String
  activities  String?
  places      String?
  startTime   String?
  endTime     String?
  imageUrl    String? // Primary photo for this day
  images      String? // JSON array of day-wise photo URLs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([dayNumber])
}

model Quotation {
  id                 String    @id @default(uuid())
  quotationNumber    String    @unique // e.g. "OOT-QT-202609-001"
  leadId             String?
  customerId         String
  packageId          String?
  destination        String
  travelStartDate    DateTime?
  travelEndDate      DateTime?
  adults             Int       @default(2)
  children           Int       @default(0)
  infants            Int       @default(0)
  accommodation      String?
  transport          String?
  activities         String?
  inclusions         String?
  exclusions         String?
  cabDetails         String?
  additionalCharges  Float     @default(0)
  paymentTerms       String?
  cancellationTerms  String?
  notes              String?
  basePrice          Float     @default(0)
  discount           Float     @default(0)
  tax                Float     @default(0)
  finalAmount        Float     @default(0)
  status             String    @default("DRAFT") // DRAFT, SENT, ACCEPTED, REJECTED, EXPIRED, CONVERTED
  termsAndConditions String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package            Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdByUser      User?     @relation("QuotationCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([quotationNumber])
  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdById])
}

model Booking {
  id              String    @id @default(uuid())
  bookingNumber   String    @unique // e.g. "OOT-BK-202609-001"
  customerId      String
  leadId          String?
  packageId       String?
  assignedUserId  String?
  travelStartDate DateTime
  travelEndDate   DateTime
  travellers      Int       @default(1)
  totalAmount     Float     @default(0)
  discount        Float     @default(0)
  finalAmount     Float     @default(0)
  bookingStatus   String    @default("CONFIRMED") // ENQUIRY, HOLD, CONFIRMED, COMPLETED, CANCELLED
  bookingDate     DateTime  @default(now())
  serviceProviders String?  // JSON array of attached service providers
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  package         Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedUser    User?         @relation("BookingAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  payments        Payment[]
  expenses        Expense[]
  agentBooking    AgentBooking?
  travellersList  Traveller[]
  cabBookings     CabBooking[]

  @@index([bookingNumber])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([bookingStatus])
  @@index([bookingDate])
}

model Traveller {
  id        String   @id @default(uuid())
  bookingId String
  name      String
  age       Int?
  gender    String? // MALE, FEMALE, OTHER
  phone     String?
  email     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id                   String   @id @default(uuid())
  bookingId            String
  customerId           String?
  amount               Float    @default(0)
  paymentDate          DateTime @default(now())
  paymentTime          String?
  paymentMethod        String   @default("UPI") // CASH, UPI, BANK_TRANSFER, CARD, OTHER
  transactionReference String?  @unique
  screenshotUrl        String?
  recordedById         String?
  paymentStatus        String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([transactionReference])
}

model Agent {
  id                 String   @id @default(uuid())
  companyName        String
  contactPerson      String
  phone              String
  email              String?
  city               String?
  state              String?
  gstNumber          String?
  panNumber          String?
  agentType          String?  @default("Silver") // Diamond, Gold, Silver
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  googleReviewUrl    String?
  googleReviewRating Float?
  googleReviewNotes  String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agentBookings AgentBooking[]

  @@index([companyName])
  @@index([phone])
  @@index([email])
  @@index([status])
}

model AgentBooking {
  id               String   @id @default(uuid())
  agentId          String
  bookingId        String   @unique
  commissionRate   Float    @default(0) // Percentage, e.g. 10%
  commissionAmount Float    @default(0)
  netAmount        Float    @default(0)
  payoutStatus     String   @default("PENDING") // PENDING, PAID, CANCELLED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([bookingId])
  @@index([payoutStatus])
}

model Expense {
  id          String   @id @default(uuid())
  category    String // HOTEL_BOOKING, TRANSPORT, GUIDE, FLIGHT_TICKETS, ENTRY_FEES, MARKETING, OFFICE, MISC
  amount      Float    @default(0)
  expenseDate DateTime @default(now())
  description String
  bookingId   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("ExpenseCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([bookingId])
  @@index([expenseDate])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String?
  action      String   // CREATE, UPDATE, DELETE, STATUS_CHANGE, LOGIN, EXPORT, IMPORT
  entity      String   // CUSTOMER, LEAD, BOOKING, PAYMENT, PACKAGE, AGENT, USER, EXPENSE
  entityId    String?
  details     String?  // Detailed description or JSON snapshot
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

model CompanySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model WhatsAppMessage {
  id             String    @id @default(uuid())
  customerId     String?
  phone          String
  messageContent String
  templateName   String?
  status         String    @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  provider       String?   // META_CLOUD_API, TWILIO, DIRECT_WEB
  externalId     String?
  errorDetails   String?
  sentByUserId   String?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([phone])
  @@index([createdAt])
}

model CabBooking {
  id                  String    @id @default(uuid())
  bookingReference    String    @unique // e.g. "OOT-CAB-202609-001"
  customerId          String?
  customerName        String
  customerPhone       String
  customerEmail       String?
  leadId              String?
  bookingId           String?
  packageId           String?
  assignedStaffId     String?
  pickupDate          DateTime
  pickupTime          String
  pickupPlace         String
  dropPlace           String
  travelRoute         String?
  enquiryDate         DateTime? @default(now())
  carNumber           String?
  vehicleType         String    @default("SEDAN") // SEDAN, SUV, INNOVA, TEMPO_TRAVELLER, HATCHBACK, LUXURY
  passengerCount      Int       @default(1)
  driverName          String?
  driverPhone         String?
  cabProvider         String?
  requiredCabType     String?   @default("AC") // AC, NON_AC
  tripType            String    @default("OUTSTATION") // ONE_WAY, ROUND_TRIP, LOCAL, OUTSTATION
  estimatedDistance   String?
  estimatedDuration   String?
  cabAmount           Float     @default(0)
  advanceAmount       Float     @default(0)
  balanceAmount       Float     @default(0)
  paymentStatus       String    @default("PENDING") // PENDING, PARTIAL, PAID, REFUNDED
  bookingStatus       String    @default("CONFIRMED") // PENDING, CONFIRMED, COMPLETED, CANCELLED, ON_TRIP
  specialInstructions String?
  internalNotes       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking             Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  package             Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedStaff       User?     @relation("CabBookingAssignedUser", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([bookingReference])
  @@index([customerPhone])
  @@index([pickupDate])
  @@index([bookingStatus])
  @@index([assignedStaffId])
}

model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  eventType   String    @default("TASK") // MEETING, TASK, REMINDER, FOLLOW_UP, CAB_TRIP, DEPARTURE, PAYMENT_DUE, LEAVE
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  userId      String?
  customerId  String?
  leadId      String?
  bookingId   String?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation("CalendarEventAssignedUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate])
  @@index([eventType])
  @@index([status])
}

model Supplier {
  id                  String    @id @default(uuid())
  name                String
  supplierType        String    @default("HOTEL") // HOTEL, TRANSPORT, CAB, FLIGHT, ACTIVITY, TOUR_OPERATOR, VISA, GUIDE, OTHER
  contactPerson       String?
  phone               String
  whatsapp            String?
  email               String?
  alternateContact    String?
  website             String?
  address             String?
  city                String?
  district            String?
  state               String?
  country             String?   @default("India")
  pincode             String?
  gstNumber           String?
  panNumber           String?
  tier                String?   @default("Silver") // Diamond, Gold, Silver
  serviceCategories   String?   // JSON array of service categories e.g. ["Hotel", "Bus"]
  categoryDetails     String?   // JSON object with category specific fields
  category            String?
  servicesProvided    String?
  destinationsCovered String?
  contractDetails     String?
  paymentTerms        String?
  creditLimit         Float?    @default(0)
  commissionDetails   String?
  bankDetails         String?
  status              String    @default("ACTIVE") // ACTIVE, INACTIVE
  assignedToId        String?
  tags                String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedUser        User?     @relation("SupplierAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([supplierType])
  @@index([phone])
  @@index([city])
  @@index([status])
  @@index([assignedToId])
}

