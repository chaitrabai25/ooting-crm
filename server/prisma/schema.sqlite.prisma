// ==============================================================================
// Ooting CRM - SQLite Database Schema (Local / Fallback)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// 1. User & Authentication
// ------------------------------------------------------------------------------
model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String    @default("SALES")
  phone              String?
  status             String    @default("ACTIVE")
  permissions        String?
  lastLoginAt        DateTime?
  otpHash            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  lastOtpRequestedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedCustomers      Customer[]       @relation("CustomerAssignedUser")
  customersCreated       Customer[]       @relation("CustomerCreatedByUser")
  customersUpdated       Customer[]       @relation("CustomerUpdatedByUser")

  assignedLeads          Lead[]           @relation("LeadAssignedUser")
  leadsCreated           Lead[]           @relation("LeadCreatedByUser")
  leadsUpdated           Lead[]           @relation("LeadUpdatedByUser")

  assignedFollowUps      FollowUp[]       @relation("FollowUpAssignedUser")

  assignedBookings       Booking[]        @relation("BookingAssignedUser")
  bookingsCreated        Booking[]        @relation("BookingCreatedByUser")
  bookingsUpdated        Booking[]        @relation("BookingUpdatedByUser")

  quotationsCreated      Quotation[]      @relation("QuotationCreatedByUser")
  quotationsUpdated      Quotation[]      @relation("QuotationUpdatedByUser")

  assignedCabBookings    CabBooking[]     @relation("CabBookingAssignedUser")
  assignedCalendarEvents CalendarEvent[]  @relation("CalendarEventAssignedUser")
  expensesCreated        Expense[]        @relation("ExpenseCreatedByUser")
  assignedSuppliers      Supplier[]       @relation("SupplierAssignedUser")
  auditLogs              AuditLog[]       @relation("UserAuditLogs")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 2. Customer Directory
// ------------------------------------------------------------------------------
model Customer {
  id             String    @id @default(uuid())
  fullName       String
  phone          String
  alternatePhone String?
  email          String?
  city           String?
  state          String?
  country        String?   @default("India")
  source         String?   @default("DIRECT")
  notes          String?
  assignedToId   String?
  status         String    @default("ACTIVE")

  createdById    String?
  updatedById    String?
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  deletedById    String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  assignedTo     User?        @relation("CustomerAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdByUser  User?        @relation("CustomerCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser  User?        @relation("CustomerUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)

  leads          Lead[]
  bookings       Booking[]
  quotations     Quotation[]
  cabBookings    CabBooking[]

  @@index([phone])
  @@index([email])
  @@index([fullName])
  @@index([assignedToId])
  @@index([isDeleted])
}

// ------------------------------------------------------------------------------
// 3. Leads & Enquiries
// ------------------------------------------------------------------------------
model Lead {
  id              String    @id @default(uuid())
  customerId      String
  assignedUserId  String?
  source          String    @default("WEBSITE")
  destination     String
  travelStartDate DateTime?
  travelEndDate   DateTime?
  adults          Int       @default(2)
  children        Int       @default(0)
  infants         Int       @default(0)
  budget          Float?
  packageId       String?
  enquiryStatus   String    @default("NEW")
  priority        String    @default("MEDIUM")
  notes           String?
  nextFollowUpAt  DateTime?

  createdById     String?
  updatedById     String?
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedById     String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedUser    User?        @relation("LeadAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser   User?        @relation("LeadCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser   User?        @relation("LeadUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)
  package         Package?     @relation(fields: [packageId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  quotations      Quotation[]
  bookings        Booking[]
  cabBookings     CabBooking[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([enquiryStatus])
  @@index([destination])
  @@index([createdAt])
  @@index([nextFollowUpAt])
  @@index([isDeleted])
}

// ------------------------------------------------------------------------------
// 4. Follow-ups & Reminders
// ------------------------------------------------------------------------------
model FollowUp {
  id             String    @id @default(uuid())
  leadId         String
  assignedUserId String?
  scheduledAt    DateTime
  type           String    @default("CALL")
  notes          String?
  status         String    @default("PENDING")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser   User?     @relation("FollowUpAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([assignedUserId])
  @@index([scheduledAt])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 5. Tour Packages & Catalog
// ------------------------------------------------------------------------------
model Package {
  id          String   @id @default(uuid())
  packageName String
  destination String
  duration    String
  description String
  price       Float    @default(0)
  packageType String   @default("HOLIDAY")
  inclusions  String?
  exclusions  String?
  imageUrl    String?
  gallery     String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itineraries ItineraryDay[]
  leads       Lead[]
  bookings    Booking[]
  quotations  Quotation[]
  cabBookings CabBooking[]

  @@index([destination])
  @@index([packageType])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 6. Day-Wise Itineraries
// ------------------------------------------------------------------------------
model ItineraryDay {
  id          String   @id @default(uuid())
  packageId   String
  dayNumber   Int
  title       String
  description String
  activities  String?
  places      String?
  startTime   String?
  endTime     String?
  imageUrl    String?
  images      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  package     Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([dayNumber])
}

// ------------------------------------------------------------------------------
// 7. Quotations & Proposals
// ------------------------------------------------------------------------------
model Quotation {
  id                 String    @id @default(uuid())
  quotationNumber    String    @unique
  leadId             String?
  customerId         String
  packageId          String?
  destination        String
  travelStartDate    DateTime?
  travelEndDate      DateTime?
  adults             Int       @default(2)
  children           Int       @default(0)
  infants            Int       @default(0)
  accommodation      String?
  transport          String?
  activities         String?
  inclusions         String?
  exclusions         String?
  cabDetails         String?
  additionalCharges  Float     @default(0)
  paymentTerms       String?
  cancellationTerms  String?
  notes              String?
  basePrice          Float     @default(0)
  discount           Float     @default(0)
  tax                Float     @default(0)
  finalAmount        Float     @default(0)
  status             String    @default("DRAFT")
  termsAndConditions String?

  createdById        String?
  updatedById        String?
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  deletedById        String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lead               Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer           Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package            Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  createdByUser      User?     @relation("QuotationCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser      User?     @relation("QuotationUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([quotationNumber])
  @@index([customerId])
  @@index([leadId])
  @@index([status])
  @@index([createdById])
  @@index([isDeleted])
}

// ------------------------------------------------------------------------------
// 8. Bookings
// ------------------------------------------------------------------------------
model Booking {
  id               String    @id @default(uuid())
  bookingNumber    String    @unique
  customerId       String
  leadId           String?
  packageId        String?
  assignedUserId   String?
  travelStartDate  DateTime
  travelEndDate    DateTime
  durationDays     Int?      @default(1)
  durationNights   Int?      @default(0)
  tripType         String?   @default("SINGLE")
  travellers       Int       @default(1)
  totalAmount      Float     @default(0)
  discount         Float     @default(0)
  finalAmount      Float     @default(0)
  bookingStatus    String    @default("CONFIRMED")
  bookingDate      DateTime  @default(now())
  serviceProviders String?
  notes            String?

  createdById      String?
  updatedById      String?
  isDeleted        Boolean   @default(false)
  deletedAt        DateTime?
  deletedById      String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer         Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lead             Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  package          Package?      @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedUser     User?         @relation("BookingAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdByUser    User?         @relation("BookingCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  updatedByUser    User?         @relation("BookingUpdatedByUser", fields: [updatedById], references: [id], onDelete: SetNull)

  payments         Payment[]
  expenses         Expense[]
  agentBooking     AgentBooking?
  travellersList   Traveller[]
  cabBookings      CabBooking[]

  @@index([bookingNumber])
  @@index([customerId])
  @@index([assignedUserId])
  @@index([bookingStatus])
  @@index([bookingDate])
  @@index([isDeleted])
}

// ------------------------------------------------------------------------------
// 9. Passengers & Travellers
// ------------------------------------------------------------------------------
model Traveller {
  id        String   @id @default(uuid())
  bookingId String
  name      String
  age       Int?
  gender    String?
  phone     String?
  email     String?
  idNumber  String?
  address   String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ------------------------------------------------------------------------------
// 10. Payments & Receipts
// ------------------------------------------------------------------------------
model Payment {
  id                   String   @id @default(uuid())
  bookingId            String
  customerId           String?
  amount               Float    @default(0)
  paymentDate          DateTime @default(now())
  paymentTime          String?
  paymentMethod        String   @default("UPI")
  transactionReference String?
  screenshotUrl        String?
  recordedById         String?
  paymentStatus        String   @default("SUCCESS")
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  booking              Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([paymentDate])
  @@index([transactionReference])
}

// ------------------------------------------------------------------------------
// 11. B2B Travel Agents & Partners
// ------------------------------------------------------------------------------
model Agent {
  id                 String   @id @default(uuid())
  companyName        String
  contactPerson      String
  phone              String
  email              String?
  city               String?
  state              String?
  gstNumber          String?
  panNumber          String?
  agentType          String?  @default("Silver")
  status             String   @default("ACTIVE")
  googleReviewUrl    String?
  googleReviewRating Float?
  googleReviewNotes  String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agentBookings AgentBooking[]

  @@index([companyName])
  @@index([phone])
  @@index([email])
  @@index([status])
}

model AgentBooking {
  id               String   @id @default(uuid())
  agentId          String
  bookingId        String   @unique
  commissionRate   Float    @default(0)
  commissionAmount Float    @default(0)
  netAmount        Float    @default(0)
  payoutStatus     String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Restrict)
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([bookingId])
  @@index([payoutStatus])
}

// ------------------------------------------------------------------------------
// 12. Office & Tour Expenses
// ------------------------------------------------------------------------------
model Expense {
  id          String   @id @default(uuid())
  category    String
  amount      Float    @default(0)
  expenseDate DateTime @default(now())
  description String
  bookingId   String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("ExpenseCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([bookingId])
  @@index([expenseDate])
}

// ------------------------------------------------------------------------------
// 13. System Audit Logs
// ------------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userName    String?
  action      String
  entity      String
  entityId    String?
  details     String?
  oldValue    String?
  newValue    String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 14. Company Branding & Settings
// ------------------------------------------------------------------------------
model CompanySetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}

// ------------------------------------------------------------------------------
// 15. WhatsApp Logs
// ------------------------------------------------------------------------------
model WhatsAppMessage {
  id             String    @id @default(uuid())
  customerId     String?
  phone          String
  messageContent String
  templateName   String?
  status         String    @default("PENDING")
  provider       String?
  externalId     String?
  errorDetails   String?
  sentByUserId   String?
  createdAt      DateTime  @default(now())

  @@index([customerId])
  @@index([phone])
  @@index([createdAt])
}

// ------------------------------------------------------------------------------
// 16. Cab Bookings & Fleet Transfers
// ------------------------------------------------------------------------------
model CabBooking {
  id                   String    @id @default(uuid())
  bookingReference     String    @unique
  customerId           String?
  customerName         String
  customerPhone        String
  customerEmail        String?
  leadId               String?
  bookingId            String?
  packageId            String?
  assignedStaffId      String?
  pickupDate           DateTime
  pickupTime           String
  pickupPlace          String
  dropPlace            String
  travelRoute          String?
  enquiryDate          DateTime? @default(now())
  carNumber            String?
  vehicleType          String    @default("SEDAN")
  passengerCount       Int       @default(1)
  driverName           String?
  driverPhone          String?
  cabProvider          String?
  requiredCabType      String?   @default("AC")
  tripType             String    @default("OUTSTATION")
  estimatedDistance    String?
  estimatedDuration    String?
  cabAmount            Float     @default(0)
  advanceAmount        Float     @default(0)
  balanceAmount        Float     @default(0)
  paymentStatus        String    @default("PENDING")
  bookingStatus        String    @default("CONFIRMED")
  specialInstructions  String?
  internalNotes        String?

  driverAllowanceType  String?
  driverAllowanceRate  Float?
  driverAllowanceDays  Int?
  driverAllowanceTotal Float?
  dutyRange            String?
  customTableRows      String?

  createdById          String?
  updatedById          String?
  isDeleted            Boolean   @default(false)
  deletedAt            DateTime?
  deletedById          String?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  customer             Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                 Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  booking              Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  package              Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  assignedStaff        User?     @relation("CabBookingAssignedUser", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([bookingReference])
  @@index([customerPhone])
  @@index([pickupDate])
  @@index([bookingStatus])
  @@index([assignedStaffId])
  @@index([isDeleted])
}

// ------------------------------------------------------------------------------
// 17. Calendar & Tasks
// ------------------------------------------------------------------------------
model CalendarEvent {
  id          String    @id @default(uuid())
  title       String
  description String?
  eventType   String    @default("TASK")
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean   @default(false)
  userId      String?
  customerId  String?
  leadId      String?
  bookingId   String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User?     @relation("CalendarEventAssignedUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startDate])
  @@index([eventType])
  @@index([status])
}

// ------------------------------------------------------------------------------
// 18. B2B Suppliers Directory
// ------------------------------------------------------------------------------
model Supplier {
  id                  String    @id @default(uuid())
  name                String
  supplierType        String    @default("HOTEL")
  contactPerson       String?
  phone               String
  whatsapp            String?
  email               String?
  alternateContact    String?
  website             String?
  address             String?
  city                String?
  district            String?
  state               String?
  country             String?   @default("India")
  pincode             String?
  gstNumber           String?
  panNumber           String?
  tier                String?   @default("Silver")
  serviceCategories   String?
  categoryDetails     String?
  category            String?
  servicesProvided    String?
  destinationsCovered String?
  contractDetails     String?
  paymentTerms        String?
  creditLimit         Float?    @default(0)
  commissionDetails   String?
  bankDetails         String?
  status              String    @default("ACTIVE")
  assignedToId        String?
  tags                String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  assignedUser        User?     @relation("SupplierAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([supplierType])
  @@index([phone])
  @@index([city])
  @@index([status])
  @@index([assignedToId])
}
